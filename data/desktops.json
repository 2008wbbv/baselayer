      "docs": "https://nixos.org/manual/nixos/stable/#ch-installation",
      "wayland": false,
      "x11": false,
      "needsXserver": false,
      "dm": "none",
      "nix": [],
      "packages": []
    },
    {
      "id": "gnome",
      "name": "GNOME",
      "kind": "de",
      "session": "gnome",
      "brand": "#4a86cf",
      "glyph": "desktop",
      "desc": "The default GNOME desktop. Wayland by default, heavily integrated, very little configuration required.",
      "home": "https://www.gnome.org/",
      "docs": "https://wiki.nixos.org/wiki/GNOME",
      "wayland": true,
      "x11": true,
      "needsXserver": true,
      "dm": "gdm",
      "ram": "high",
      "nix": [
        "services.desktopManager.gnome.enable = true;"
      ],
      "excludeOption": "environment.gnome.excludePackages",
      "excludeDefaults": [
        "gnome-tour",
        "gnome-connections",
        "epiphany",
        "geary",
        "gnome-maps",
        "gnome-music",
        "totem"
      ],
      "packages": [
        "gnome-tweaks"
      ]
